#!/usr/bin/env bash

set -euo pipefail

workspace=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
container_ids=()

while IFS= read -r container_id; do
  [ -n "$container_id" ] && container_ids+=("$container_id")
done < <(docker ps -aq --filter "label=devcontainer.local_folder=$workspace")

if [ "${#container_ids[@]}" -eq 0 ]; then
  echo "No dev container found for $workspace"
  exit 0
fi

image_ids=()
for container_id in "${container_ids[@]}"; do
  image_id=$(docker inspect --format '{{.Image}}' "$container_id")
  image_is_known=false
  for known_image_id in "${image_ids[@]}"; do
    if [ "$known_image_id" = "$image_id" ]; then
      image_is_known=true
      break
    fi
  done
  if [ "$image_is_known" = false ]; then
    image_ids+=("$image_id")
  fi
done

docker container rm --force "${container_ids[@]}"

for image_id in "${image_ids[@]}"; do
  remaining_containers=$(docker ps -aq --filter "ancestor=$image_id")
  if [ -n "$remaining_containers" ]; then
    echo "Keeping image $image_id because another container uses it"
  else
    docker image rm "$image_id"
  fi
done
